{
  "modules": [
    "./register.tsx"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.cmd\" \"${CLAUDE_PLUGIN_ROOT}/hooks/git_guard.py\" pre"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.cmd\" \"${CLAUDE_PLUGIN_ROOT}/hooks/edit_guard.py\" pre"
          }
        ]
      },
      {
        "matcher": "mcp__.*(pull_request|wiki|branch|link).*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.cmd\" \"${CLAUDE_PLUGIN_ROOT}/hooks/outbound_guard.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/run.cmd\" \"${CLAUDE_PLUGIN_ROOT}/hooks/approval_hook.py\" post"
          }
        ]
      }
    ]
  }
}
